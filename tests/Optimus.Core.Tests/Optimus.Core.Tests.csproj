<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for Optimus.Core. net8.0 so they run anywhere (no CorelDRAW, no Windows-only deps).
    Everything COM/Win32 is excluded by construction: Core has no such references, so if a test
    needs CorelDRAW to pass, the logic is in the wrong project.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Optimus.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Optimus.Core\Optimus.Core.csproj" />
  </ItemGroup>

</Project>
