<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optimus.Interop — the ONLY place that talks to CorelDRAW.

    net48 (the framework the CorelDRAW addon host loads) and late-bound `dynamic` COM, so one
    binary drives CorelDRAW 2024/25/26. Deliberately dumb: it reads/writes the document and hands
    plain data to Optimus.Core, which owns every decision.

    HOUSE RULE: no VGCore constant or member enters this project without being grepped in
    docs/vgcore-tlb-dump.txt first. Guessing `cdrMillimeter` as 4 (it is 3; 4 is centimetres) is
    the 10x bug that broke SisCut and shipped in Optimus v1.0.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Optimus.Interop</RootNamespace>
    <AssemblyName>Optimus.Interop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimus.Core\Optimus.Core.csproj" />
  </ItemGroup>

</Project>
